n No: 38 ended. Search finished for the next optimal point.\n","Time taken: 179.2553\n","Function value obtained: 90.5280\n","Current minimum: 90.3902\n","Iteration No: 39 started. Searching for the next optimal point.\n","Iteration No: 39 ended. Search finished for the next optimal point.\n","Time taken: 180.1630\n","Function value obtained: 89.9505\n","Current minimum: 89.9505\n","Iteration No: 40 started. Searching for the next optimal point.\n","Iteration No: 40 ended. Search finished for the next optimal point.\n","Time taken: 184.1614\n","Function value obtained: 90.1873\n","Current minimum: 89.9505\n","Iteration No: 41 started. Searching for the next optimal point.\n","Iteration No: 41 ended. Search finished for the next optimal point.\n","Time taken: 204.2230\n","Function value obtained: 89.6789\n","Current minimum: 89.6789\n","Iteration No: 42 started. Searching for the next optimal point.\n","Iteration No: 42 ended. Search finished for the next optimal point.\n","Time taken: 237.9462\n","Function value obtained: 90.3814\n","Current minimum: 89.6789\n","Iteration No: 43 started. Searching for the next optimal point.\n","Iteration No: 43 ended. Search finished for the next optimal point.\n","Time taken: 184.6289\n","Function value obtained: 90.9669\n","Current minimum: 89.6789\n","Iteration No: 44 started. Searching for the next optimal point.\n","Iteration No: 44 ended. Search finished for the next optimal point.\n","Time taken: 54.8192\n","Function value obtained: 95.2062\n","Current minimum: 89.6789\n","Iteration No: 45 started. Searching for the next optimal point.\n","Iteration No: 45 ended. Search finished for the next optimal point.\n","Time taken: 172.9293\n","Function value obtained: 95.4697\n","Current minimum: 89.6789\n","Iteration No: 46 started. Searching for the next optimal point.\n","Iteration No: 46 ended. Search finished for the next optimal point.\n","Time taken: 190.3939\n","Function value obtained: 90.1630\n","Current minimum: 89.6789\n","Iteration No: 47 started. Searching for the next optimal point.\n","Iteration No: 47 ended. Search finished for the next optimal point.\n","Time taken: 104.8905\n","Function value obtained: 91.0166\n","Current minimum: 89.6789\n","Iteration No: 48 started. Searching for the next optimal point.\n","Iteration No: 48 ended. Search finished for the next optimal point.\n","Time taken: 276.1360\n","Function value obtained: 90.3234\n","Current minimum: 89.6789\n","Iteration No: 49 started. Searching for the next optimal point.\n","Iteration No: 49 ended. Search finished for the next optimal point.\n","Time taken: 42.2104\n","Function value obtained: 92.1458\n","Current minimum: 89.6789\n","Iteration No: 50 started. Searching for the next optimal point.\n","Iteration No: 50 ended. Search finished for the next optimal point.\n","Time taken: 136.7147\n","Function value obtained: 90.9828\n","Current minimum: 89.6789\n","\n","======================================================================\n","РЕЗУЛЬТАТЫ:\n","Лучшее значение метрики: -89.6789\n","Лучшие параметры: {'iterations': np.int64(350), 'depth': np.int64(10), 'learning_rate': 0.13384880795602305, 'l2_leaf_reg': 1.0, 'border_count': np.int64(175)}\n","======================================================================\n"]}],"source":["log_interval = 5\n","log_file = os.path.join(base_log_dir, 'bayes_CatBoost_Superconductivity_logs.csv')\n","\n","test_results = run_bayesian_optimization('Superconductivity', model_name = 'CatBoost', n_iter=50,\n","                                        log_interval = log_interval, log_file = log_file)"]},{"cell_type":"markdown","metadata":{"id":"eUBRhNzcnKRH"},"source":["### Поиск по одной модели для всех датасетов"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"uR2TZlpcnOET"},"outputs":[],"source":["import os\n","\n","def optimize_model_on_all_datasets(model_name, n_iter=50, log_interval=5, base_log_dir='logs'):\n","    \"\"\"\n","    Запускает run_bayesian_optimization для выбранной модели на всех датасетах,\n","    где задача (классификация/регрессия) поддерживается моделью.\n","\n","    Параметры\n","    ---------\n","    model_name : str\n","        Имя модели ('LogisticRegression', 'RandomForest', 'LightGBM', 'CatBoost',\n","                    'Ridge', 'Lasso', 'ElasticNet').\n","    n_iter : int\n","        Число итераций оптимизации.\n","    log_interval : int\n","        Интервал сохранения логов (каждые N итераций).\n","    base_log_dir : str\n","        Папка, в которую будут сохраняться логи.\n","    \"\"\"\n","    # Создаём папку для логов, если её нет\n","    os.makedirs(base_log_dir, exist_ok=True)\n","\n","    # Список всех датасетов\n","    all_datasets = list(DATASET_CONFIGS.keys())\n","\n","    for dataset_name in all_datasets:\n","        # Определяем задачу датасета\n","        task = DATASET_CONFIGS[dataset_name]['task']\n","\n","        # Проверяем, поддерживает ли модель эту задачу\n","        if get_model_for_task(model_name, task) is None:\n","            print(f\"Пропускаем {dataset_name} – модель {model_name} не поддерживает задачу {task}\")\n","            continue\n","\n","        # Формируем имя файла логов\n","        log_filename = f\"bayes_{model_name}_{dataset_name}_logs.csv\"\n","        log_filepath = os.path.join(base_log_dir, log_filename)\n","\n","        print(f\"\\n====== Запуск {model_name} на {dataset_name} ======\")\n","\n","        # Запускаем оптимизацию (внутри уже есть запись логов)\n","        run_bayesian_optimization(\n","            dataset_name=dataset_name,\n","            model_name=model_name,\n","            n_iter=n_iter,\n","            log_interval=log_interval,\n","            log_file=log_filepath\n","        )"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":2509242,"status":"error","timestamp":1780070000051,"user":{"displayName":"Григорий Фетисов","userId":"04960233417679212424"},"user_tz":-180},"id":"wKt2540unePt","outputId":"3d872674-a241-4c82-c96b-7c6c9d0ae420"},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","====== Запуск RandomForest на Adult ======\n","\n","======================================================================\n","Байесовская оптимизация: RandomForest на Adult\n","Задача: CLASSIFICATION\n","======================================================================\n","Размер данных: X=(48842, 14), y=(48842,)\n","Кросс-валидация: 3-fold\n","Метрика: ROC-AUC\n","\n","Проверка базовой кросс-валидации...\n","Базовая ROC-AUC: 0.9064 (+/- 0.0020)\n","\n","Запуск оптимизации (50 итераций)...\n","Fitting 3 folds for each of 1 candidates, totalling 3 fits\n","[CV 1/3; 1/1] START model__max_depth=10, model__max_features=None, model__min_samples_leaf=9, model__min_samples_split=8, model__n_estimators=218\n","[CV 1/3; 1/1] END model__max_depth=10, model__max_features=None, model__min_samples_leaf=9, model__min_samples_split=8, model__n_estimators=218;, score=0.913 total time=  24.2s\n","[CV 2/3; 1/1] START model__max_depth=10, model__max_features=None, model__min_samples_leaf=9, model__min_samples_split=8, model__n_estimators=218\n","[CV 2/3; 1/1] END model__max_depth=10, model__max_features=None, model__min_samples_leaf=9, model__min_samples_split=8, model__n_estimators=218;, score=0.915 total time=  24.0s\n","[CV 3/3; 1/1] START model__max_depth=10, model__max_features=None, model__min_samples_leaf=9, model__min_samples_split=8, model__n_estimators=218\n","[CV 3/3; 1/1] END model__max_depth=10, model__max_features=None, model__min_samples_leaf=9, model__min_samples_split=8, model__n_estimators=218;, score=0.915 total time=  23.3s\n","Fitting 3 folds for each of 1 candidates, totalling 3 fits\n","[CV 1/3; 1/1] START model__max_depth=17, model__max_features=None, model__min_samples_leaf=4, model__min_samples_split=19, model__n_estimators=266\n","[CV 1/3; 1/1] END model__max_depth=17, model__max_featur